{
  // Cloudflare Workers config. Cloudflare's dashboard deploy runs `npx wrangler deploy`, which reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ace-coatings-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker first; every other path is served straight from ./public.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
